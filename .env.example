# Local development example. Copy to .env and replace blank credentials locally.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9091

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/travel_diary_dev
SPRING_DATASOURCE_USERNAME=travel_diary
SPRING_DATASOURCE_PASSWORD=travel_diary_password

MAPS_SERVICE_BASE_URL=http://localhost:8082
IDENTITY_SERVICE_BASE_URL=http://localhost:8081
IDENTITY_SERVICE_CONNECT_TIMEOUT=2s
IDENTITY_SERVICE_READ_TIMEOUT=3s

CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ISSUER=travel-planner-backend
JWT_ACCESS_TOKEN_TTL=30m
JWT_SECRET=local-development-jwt-secret-change-me

REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax

OAUTH_STATE_TTL=5m
OAUTH_EXCHANGE_CODE_TTL=60s
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH_HTTP_CONNECT_TIMEOUT=3s
OAUTH_HTTP_READ_TIMEOUT=5s
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/google/callback
GOOGLE_OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USER_INFO_URI=https://openidconnect.googleapis.com/v1/userinfo
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/naver/callback
NAVER_OAUTH_AUTHORIZATION_URI=https://nid.naver.com/oauth2.0/authorize
NAVER_OAUTH_TOKEN_URI=https://nid.naver.com/oauth2.0/token
NAVER_OAUTH_USER_INFO_URI=https://openapi.naver.com/v1/nid/me

PROFILE_IMAGE_STORAGE_ENABLED=false
PROFILE_IMAGE_STORAGE_ENDPOINT=
PROFILE_IMAGE_STORAGE_REGION=ap-northeast-2
PROFILE_IMAGE_STORAGE_ACCESS_KEY=
PROFILE_IMAGE_STORAGE_SECRET_KEY=
PROFILE_IMAGE_STORAGE_BUCKET=
PROFILE_IMAGE_PUBLIC_BASE_URL=
PROFILE_IMAGE_STORAGE_PATH_STYLE_ACCESS_ENABLED=true
PROFILE_IMAGE_UPLOAD_URL_TTL=10m

LOGGING_FILE_NAME=logs/travel-planner.log

# Optional: only for local Gradle access to GitHub Packages. Never commit real values.
# GITHUB_PACKAGES_USER=
# GITHUB_PACKAGES_TOKEN=
